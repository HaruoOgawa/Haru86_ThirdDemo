struct STrs
{
	vec4 pos;
	vec4 rot;
	vec4 scl;
	vec4 tan;
	ivec4 param; // ivec4(group, my_segment, now_segment, 0)
};

layout(std430, binding = SegmentBufferBinding) buffer in_trs_buffer
{
	STrs trs[];
} out_trs_buffer;

struct SGroup
{
	vec4 param; // vec4(now_segment, life, IsPermitUpdate, 0.0)
};

layout(std430, binding = GroupBufferBinding) buffer in_group_buffer
{
	SGroup group[];
} out_group_buffer;

float rand(vec2 st){
    return fract(
        sin(dot(st.xy,vec2(12.9898,78.233)))*43758.5453123
    );
}

void SphereTrail(inout STrs trs)
{
	float offsetA = rand(vec2(100.9123, 7.71562) * float(trs.param.x)) * 2.0 * 3.1415;
	float offsetB = rand(vec2(6.601,80.123) * float(trs.param.x)) * 2.0 * 3.1415;
	//float r = 2.0;
	float r = 10.0;

	// ˆÚ“®‚Ì—”‚ÍgroupŠe‚És‚¤
	trs.pos = vec4(
		r*cos(_time+offsetA)*cos(_time+offsetB),
		r*cos(_time+offsetA)*sin(_time+offsetB),
		r*sin(_time+offsetA),
		1.0
	);
}

float hcys(float t,float rc,float rm,float rd){	return (rc-rm)*cos(t) + rd*cos( ((rc-rm)/rm) * t );}
float hcyc(float t,float rc,float rm,float rd){	return (rc-rm)*sin(t) - rd*sin( ((rc-rm)/rm) * t );}

