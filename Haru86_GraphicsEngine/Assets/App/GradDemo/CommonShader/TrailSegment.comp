void CalTrailSegment(uvec3 DID)
{
	int id = int(DID.x);
	STrs trs = out_trs_buffer.trs[id];
	SGroup group = out_group_buffer.group[trs.param.x];

	int my_segment = trs.param.y; 
	
	if(my_segment == int(group.param.x) && int(group.param.z) == 1)
	{
		if(_SegmentFuncIndex == 0)
		{
			SphereTrail(trs);
		}
		else if(_SegmentFuncIndex == 1)
		{
			AuraTrail(trs, float(id));
		}
	}

	trs.param.z = int(group.param.x);
	//trs.param.w = int(floor(_time));

	out_trs_buffer.trs[id] = trs;
}

layout(local_size_x=NUMTHREAD, local_size_y=1, local_size_z=1) in;

